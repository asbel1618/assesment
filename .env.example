# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Password of the read-only role `app_ro` used by the API
APP_RO_PASSWORD=
# Owner role, used by the loader.
# host: postgresql+psycopg://USER:PASS@127.0.0.1:5432/DB  |  container: host `db`
DATABASE_URL=
# app_ro role, used by the API (same host rule)
READONLY_DATABASE_URL=
# host: http://127.0.0.1:8080/v1  |  container: http://llm:8080/v1
LLM_BASE_URL=

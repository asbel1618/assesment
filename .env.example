# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Password of the read-only role `app_ro` used by the API
APP_RO_PASSWORD=
# Owner role, used by the loader.
# host: postgresql+psycopg://USER:PASS@127.0.0.1:5432/DB  |  container: host `db`
DATABASE_URL=
# app_ro role, used by the API (same host rule)
READONLY_DATABASE_URL=
# Any OpenAI-compatible endpoint, e.g. https://api.openai.com/v1.
# The same value is used by `docker-compose.yml` (api container) and by local dev (--env-file).
# LLM server on your host: http://127.0.0.1:8080/v1 for local dev, but
# http://host.docker.internal:8080/v1 when the api runs in docker-compose.yml.
# docker-compose-local-llm.yaml ignores this and uses http://llm:8080/v1.
LLM_BASE_URL=
# Optional: sent as `Authorization: Bearer ...` when set
LLM_API_KEY=
# Optional: sent as `model` in the request; most hosted providers require it
LLM_MODEL=
# Optional: set to true to send chat_template_kwargs {"enable_thinking": false}.
# Needed for Qwen3.x on llama.cpp (--jinja); leave empty for hosted providers
# that reject unknown fields (e.g. OpenAI). docker-compose-local-llm.yaml sets it itself.
LLM_DISABLE_THINKING=

# --- Only for docker-compose-local-llm.yaml: host-specific llm settings (defaults match the dev host) ---
# Directory containing the GGUF model file
# MODEL_DIR=/home/asbel/models
# LLM_MODEL_FILE=Qwen3.5-9B-UD-Q4_K_XL.gguf
# llama.cpp image (server-intel = Intel GPU; use docker-compose.cpu.yml for CPU)
# LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-intel
# Host GIDs of `render` and `video` (getent group render video)
# RENDER_GID=987
# VIDEO_GID=983
